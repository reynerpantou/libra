# Copy to .env and adjust. `docker compose` loads this file automatically.
LIBRA_ADDR=:8080
# Postgres connection for running the binary outside Docker (`make run`, `make demo`).
# The Makefile loads this file. Use the same user/password as POSTGRES_* below.
LIBRA_DATABASE_URL=postgres://libra:CHANGE-ME@localhost:5432/libra?sslmode=disable
# Credentials docker compose creates Postgres with. Required, e.g. `openssl rand -hex 24`.
POSTGRES_USER=libra
POSTGRES_PASSWORD=
POSTGRES_DB=libra
# HTTPS-only cookies. Browsers still accept them on http://localhost.
LIBRA_COOKIE_SECURE=true
LIBRA_SESSION_TTL_HOURS=168
# Reverse proxies whose X-Forwarded-For is trusted (IPs/CIDRs).
LIBRA_TRUSTED_PROXIES=
# Where people open Libra; Google/Apple return to <LIBRA_PUBLIC_URL>/api/auth/<provider>/callback.
LIBRA_PUBLIC_URL=http://localhost:8080
# The owner account created on first run, and the Google/Apple email that signs in as it.
LIBRA_ADMIN_USER=admin
LIBRA_ADMIN_EMAIL=
# How often the data pipeline runs (0 = only on demand / via `libra pipeline`).
LIBRA_PIPELINE_INTERVAL_SECONDS=300
# Sign in with Google (OAuth client, type "Web").
LIBRA_GOOGLE_CLIENT_ID=
LIBRA_GOOGLE_CLIENT_SECRET=
# Sign in with Apple. CLIENT_ID is the Services ID; PRIVATE_KEY is the .p8 contents.
LIBRA_APPLE_CLIENT_ID=
LIBRA_APPLE_TEAM_ID=
LIBRA_APPLE_KEY_ID=
LIBRA_APPLE_PRIVATE_KEY=
